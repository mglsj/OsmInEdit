{
	"name": "indoor-id",
	"version": "0.0.1",
	"description": "Web tool for editing OpenStreetMap building indoors data",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "mglsj",
	"repository": {
		"type": "git",
		"url": "https://github.com/mglsj/indoor-id.git"
	},
	"keywords": [
		"openstreetmap",
		"indoor",
		"editor",
		"osm",
		"building"
	],
	"engines": {
		"node": ">=24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "bun scripts/build-presets.ts && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"presets": "bun scripts/build-presets.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@mapbox/maki": "8.2.0",
		"@maplibre/maplibre-gl-style-spec": "26.4.4",
		"@openstreetmap/id-tagging-schema": "7.3.0",
		"@playwright/test": "1.56.1",
		"@rapideditor/temaki": "5.13.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"osm-auth": "3.2.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	},
	"dependencies": {
		"@lucide/svelte": "1.57.0",
		"bits-ui": "2.19.5",
		"maplibre-gl": "6.14.0"
	},
	"packageManager": "bun@1.4.2"
}
