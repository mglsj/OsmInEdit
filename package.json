{
	"name": "osm-indoor-editor",
	"version": "2.0.0-dev",
	"description": "Web tool for editing OpenStreetMap building indoors data",
	"private": true,
	"type": "module",
	"license": "ISC",
	"author": "Adrien PAVIE, Daimler AG",
	"repository": {
		"type": "git",
		"url": "https://github.com/mglsj/OsmInEdit.git"
	},
	"keywords": [
		"openstreetmap",
		"indoor",
		"editor",
		"osm",
		"building"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.56.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.20.5",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	},
	"dependencies": {
		"@lucide/svelte": "1.57.0",
		"bits-ui": "2.19.5",
		"maplibre-gl": "6.14.0"
	}
}
